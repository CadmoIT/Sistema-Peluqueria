# Documenta las variables necesarias sin incluir secretos reales.
MARCA_APP=TurnosRapidos
NODE_ENV=development
WEB_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Sólo el nombre base, sin protocolo ni comodín. En producción: site.turnosrapidos.com.ar
PUBLIC_SITE_DOMAIN=
DATABASE_URL=postgresql://turnos:turnos@localhost:5433/turnos_rapidos
BETTER_AUTH_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_HABILITADO=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Calendar API: permiso calendar.app.created y retorno WEB_URL/api/integraciones/google-calendar/callback.
# Estas mismas credenciales deben estar disponibles en web y worker para reintentos cada 5 minutos.
GOOGLE_MAPS_API_KEY=
INTEGRATIONS_ENCRYPTION_KEY=
# Cloudinary: preset firmado con allowed_formats; la interfaz limita cada archivo a 8 MiB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
EMAIL_REMITENTE=TurnosRapidos <no-reply@turnosrapidos.com.ar>
# Cuenta central para avisos de turnos. No se envía nada si faltan credenciales.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_REMITENTE=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_TOKEN=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_PLANTILLA_CONFIRMACION=
META_WHATSAPP_PLANTILLA_RECORDATORIO=
META_GRAPH_API_VERSION=v23.0
RESEND_API_KEY=
# R2 sólo se conserva para servir imágenes históricas; las nuevas cargas usan Cloudinary.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turnos-rapidos
