// Modela la base relacional multiempresa completa de TurnosRapidos.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolMembresia {
  DUENO
  ADMINISTRADOR
  PROFESIONAL
}

enum EstadoReserva {
  BORRADOR
  RETENIDA
  PENDIENTE_PAGO
  CONFIRMADA
  COMPLETADA
  AUSENTE
  CANCELADA
  VENCIDA
}

enum EstadoSuscripcion {
  CONFIGURACION_GRATUITA
  ACTIVA
  EN_GRACIA
  PAUSADA
  CANCELADA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
  REEMBOLSADO_PARCIAL
}

enum TipoMovimientoStock {
  INGRESO
  VENTA
  CONSUMO
  AJUSTE
  DEVOLUCION
  RESERVA
  LIBERACION
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
  APERTURA
  CIERRE
  AJUSTE
}

model Usuario {
  id              String        @id @default(cuid())
  nombre          String
  email           String        @unique
  emailVerificado Boolean       @default(false)
  imagen          String?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt
  membresias      Membresia[]
  sesiones        Sesion[]
  cuentas         CuentaOAuth[]
  auditorias      Auditoria[]
}

model Sesion {
  id            String   @id @default(cuid())
  usuarioId     String
  token         String   @unique
  expiraEn      DateTime
  ip            String?
  agente        String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model CuentaOAuth {
  id                   String    @id @default(cuid())
  usuarioId            String
  proveedor            String
  cuentaProveedorId    String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiraEn  DateTime?
  refreshTokenExpiraEn DateTime?
  alcance              String?
  contrasena           String?
  creadoEn             DateTime  @default(now())
  actualizadoEn        DateTime  @updatedAt
  usuario              Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, cuentaProveedorId])
}

model Verificacion {
  id            String   @id @default(cuid())
  identificador String
  valor         String
  expiraEn      DateTime
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([identificador])
}

model Negocio {
  id               String              @id @default(cuid())
  slug             String              @unique
  nombre           String
  descripcion      String?
  telefono         String?
  email            String?
  zonaHoraria      String              @default("America/Argentina/Buenos_Aires")
  publicado        Boolean             @default(false)
  configuracion    Json?
  creadoEn         DateTime            @default(now())
  actualizadoEn    DateTime            @updatedAt
  membresias       Membresia[]
  sedes            Sede[]
  categorias       CategoriaServicio[]
  servicios        Servicio[]
  combos           Combo[]
  profesionales    Profesional[]
  clientes         Cliente[]
  reservas         Reserva[]
  productos        Producto[]
  ventas           Venta[]
  movimientosCaja  MovimientoCaja[]
  suscripcion      Suscripcion?
  dominios         Dominio[]
  cupones          Cupon[]
  giftCards        GiftCard[]
  consumosWhatsapp ConsumoWhatsapp[]
  eventosExternos  EventoExterno[]
  auditorias       Auditoria[]
}

model Membresia {
  id          String       @id @default(cuid())
  usuarioId   String
  negocioId   String
  rol         RolMembresia
  activo      Boolean      @default(true)
  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  negocio     Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  profesional Profesional?

  @@unique([usuarioId, negocioId])
  @@index([negocioId, rol])
}

model Sede {
  id              String            @id @default(cuid())
  negocioId       String
  nombre          String
  direccion       String
  telefono        String?
  latitud         Decimal?          @db.Decimal(10, 7)
  longitud        Decimal?          @db.Decimal(10, 7)
  activa          Boolean           @default(true)
  negocio         Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  horarios        HorarioSede[]
  profesionales   ProfesionalSede[]
  reservas        Reserva[]
  existencias     Existencia[]
  ventas          Venta[]
  movimientosCaja MovimientoCaja[]

  @@unique([negocioId, nombre])
  @@index([negocioId, activa])
}

model HorarioSede {
  id        String  @id @default(cuid())
  negocioId String
  sedeId    String
  diaSemana Int
  abre      String
  cierra    String
  activo    Boolean @default(true)
  sede      Sede    @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@index([negocioId, sedeId, diaSemana])
}

model CategoriaServicio {
  id        String     @id @default(cuid())
  negocioId String
  nombre    String
  orden     Int        @default(0)
  negocio   Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servicios Servicio[]

  @@unique([negocioId, nombre])
}

model Servicio {
  id              String                @id @default(cuid())
  negocioId       String
  categoriaId     String?
  nombre          String
  descripcion     String?
  precio          Decimal               @db.Decimal(12, 2)
  duracionMinutos Int
  bufferMinutos   Int                   @default(0)
  porcentajeSena  Decimal?              @db.Decimal(5, 2)
  imagen          String?
  activo          Boolean               @default(true)
  negocio         Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria       CategoriaServicio?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  profesionales   ProfesionalServicio[]
  combos          ComboServicio[]
  itemsReserva    ReservaServicio[]

  @@index([negocioId, categoriaId, activo])
}

model Combo {
  id          String          @id @default(cuid())
  negocioId   String
  nombre      String
  descripcion String?
  precio      Decimal         @db.Decimal(12, 2)
  activo      Boolean         @default(true)
  negocio     Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servicios   ComboServicio[]

  @@index([negocioId, activo])
}

model ComboServicio {
  comboId    String
  servicioId String
  orden      Int
  combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@id([comboId, servicioId])
}

model Profesional {
  id          String                @id @default(cuid())
  negocioId   String
  membresiaId String?               @unique
  nombre      String
  biografia   String?
  foto        String?
  activo      Boolean               @default(true)
  negocio     Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  membresia   Membresia?            @relation(fields: [membresiaId], references: [id], onDelete: SetNull)
  sedes       ProfesionalSede[]
  servicios   ProfesionalServicio[]
  horarios    HorarioProfesional[]
  bloqueos    BloqueoAgenda[]
  reservas    Reserva[]
  comisiones  Comision[]

  @@index([negocioId, activo])
}

model ProfesionalSede {
  profesionalId String
  sedeId        String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  sede          Sede        @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([profesionalId, sedeId])
}

model ProfesionalServicio {
  profesionalId String
  servicioId    String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  servicio      Servicio    @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@id([profesionalId, servicioId])
}

model HorarioProfesional {
  id            String      @id @default(cuid())
  negocioId     String
  profesionalId String
  sedeId        String
  diaSemana     Int
  comienza      String
  termina       String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@index([negocioId, profesionalId, sedeId, diaSemana])
}

model BloqueoAgenda {
  id            String      @id @default(cuid())
  negocioId     String
  profesionalId String
  inicio        DateTime    @db.Timestamptz
  fin           DateTime    @db.Timestamptz
  motivo        String?
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@index([negocioId, profesionalId, inicio, fin])
}

model Cliente {
  id             String    @id @default(cuid())
  negocioId      String
  nombre         String
  email          String?
  telefono       String
  notas          String?
  aceptaWhatsapp Boolean   @default(false)
  puntos         Int       @default(0)
  creadoEn       DateTime  @default(now())
  negocio        Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  reservas       Reserva[]
  ventas         Venta[]

  @@unique([negocioId, telefono])
  @@index([negocioId, email])
}

model Reserva {
  id            String            @id @default(cuid())
  negocioId     String
  sedeId        String
  profesionalId String
  clienteId     String
  codigo        String
  estado        EstadoReserva     @default(BORRADOR)
  inicio        DateTime          @db.Timestamptz
  fin           DateTime          @db.Timestamptz
  retenidaHasta DateTime?         @db.Timestamptz
  total         Decimal           @db.Decimal(12, 2)
  sena          Decimal           @db.Decimal(12, 2)
  notas         String?
  creadoEn      DateTime          @default(now())
  negocio       Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sede          Sede              @relation(fields: [sedeId], references: [id])
  profesional   Profesional       @relation(fields: [profesionalId], references: [id])
  cliente       Cliente           @relation(fields: [clienteId], references: [id])
  servicios     ReservaServicio[]
  pagos         Pago[]

  @@unique([negocioId, codigo])
  @@index([negocioId, sedeId, inicio])
  @@index([negocioId, profesionalId, inicio, fin])
}

model ReservaServicio {
  id              String   @id @default(cuid())
  reservaId       String
  servicioId      String
  orden           Int
  precio          Decimal  @db.Decimal(12, 2)
  duracionMinutos Int
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  servicio        Servicio @relation(fields: [servicioId], references: [id])

  @@unique([reservaId, orden])
}

model Producto {
  id           String            @id @default(cuid())
  negocioId    String
  nombre       String
  sku          String?
  descripcion  String?
  precio       Decimal           @db.Decimal(12, 2)
  costo        Decimal?          @db.Decimal(12, 2)
  imagen       String?
  ventaPublica Boolean           @default(false)
  activo       Boolean           @default(true)
  negocio      Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  existencias  Existencia[]
  itemsVenta   VentaItem[]
  movimientos  MovimientoStock[]

  @@unique([negocioId, sku])
  @@index([negocioId, activo, ventaPublica])
}

model Existencia {
  id         String   @id @default(cuid())
  negocioId  String
  sedeId     String
  productoId String
  cantidad   Int      @default(0)
  minimo     Int      @default(0)
  sede       Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([sedeId, productoId])
  @@index([negocioId, cantidad])
}

model MovimientoStock {
  id         String              @id @default(cuid())
  negocioId  String
  productoId String
  sedeId     String
  tipo       TipoMovimientoStock
  cantidad   Int
  referencia String?
  creadoEn   DateTime            @default(now())
  producto   Producto            @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([negocioId, sedeId, creadoEn])
}

model Venta {
  id        String      @id @default(cuid())
  negocioId String
  sedeId    String
  clienteId String?
  total     Decimal     @db.Decimal(12, 2)
  creadoEn  DateTime    @default(now())
  negocio   Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sede      Sede        @relation(fields: [sedeId], references: [id])
  cliente   Cliente?    @relation(fields: [clienteId], references: [id])
  items     VentaItem[]
  pagos     Pago[]

  @@index([negocioId, sedeId, creadoEn])
}

model VentaItem {
  id         String    @id @default(cuid())
  ventaId    String
  productoId String?
  concepto   String
  cantidad   Int
  precio     Decimal   @db.Decimal(12, 2)
  venta      Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto   Producto? @relation(fields: [productoId], references: [id])
}

model MovimientoCaja {
  id        String             @id @default(cuid())
  negocioId String
  sedeId    String
  tipo      TipoMovimientoCaja
  concepto  String
  monto     Decimal            @db.Decimal(12, 2)
  creadoEn  DateTime           @default(now())
  negocio   Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sede      Sede               @relation(fields: [sedeId], references: [id])

  @@index([negocioId, sedeId, creadoEn])
}

model Comision {
  id            String      @id @default(cuid())
  negocioId     String
  profesionalId String
  referenciaId  String
  porcentaje    Decimal     @db.Decimal(5, 2)
  monto         Decimal     @db.Decimal(12, 2)
  creadaEn      DateTime    @default(now())
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  @@index([negocioId, profesionalId, creadaEn])
}

model Pago {
  id            String     @id @default(cuid())
  negocioId     String
  reservaId     String?
  ventaId       String?
  proveedor     String     @default("mercadopago")
  proveedorId   String?    @unique
  idempotencia  String     @unique
  estado        EstadoPago @default(PENDIENTE)
  monto         Decimal    @db.Decimal(12, 2)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  reserva       Reserva?   @relation(fields: [reservaId], references: [id])
  venta         Venta?     @relation(fields: [ventaId], references: [id])

  @@index([negocioId, estado, creadoEn])
}

model Suscripcion {
  id              String            @id @default(cuid())
  negocioId       String            @unique
  plan            String
  estado          EstadoSuscripcion @default(CONFIGURACION_GRATUITA)
  precioMensual   Decimal           @db.Decimal(12, 2)
  proveedorId     String?           @unique
  proximoCobro    DateTime?
  graciaHasta     DateTime?
  cancelarAlFinal Boolean           @default(false)
  negocio         Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
}

model Dominio {
  id         String    @id @default(cuid())
  negocioId  String
  host       String    @unique
  principal  Boolean   @default(false)
  gestionado Boolean   @default(false)
  verificado Boolean   @default(false)
  venceEn    DateTime?
  negocio    Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId, principal])
}

model Cupon {
  id          String    @id @default(cuid())
  negocioId   String
  codigo      String
  porcentaje  Decimal?  @db.Decimal(5, 2)
  monto       Decimal?  @db.Decimal(12, 2)
  usosMaximos Int?
  venceEn     DateTime?
  activo      Boolean   @default(true)
  negocio     Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, codigo])
}

model GiftCard {
  id        String    @id @default(cuid())
  negocioId String
  codigo    String
  saldo     Decimal   @db.Decimal(12, 2)
  venceEn   DateTime?
  negocio   Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, codigo])
}

model ConsumoWhatsapp {
  id               String   @id @default(cuid())
  negocioId        String
  categoria        String
  destinatarioHash String
  costo            Decimal  @db.Decimal(12, 4)
  enviadoEn        DateTime @default(now())
  negocio          Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId, enviadoEn])
}

model EventoExterno {
  id          String    @id @default(cuid())
  negocioId   String?
  proveedor   String
  eventoId    String
  tipo        String
  contenido   Json
  procesadoEn DateTime?
  recibidoEn  DateTime  @default(now())
  negocio     Negocio?  @relation(fields: [negocioId], references: [id], onDelete: SetNull)

  @@unique([proveedor, eventoId])
  @@index([negocioId, recibidoEn])
}

model Auditoria {
  id        String   @id @default(cuid())
  negocioId String
  usuarioId String?
  accion    String
  recurso   String
  recursoId String?
  detalle   Json?
  ip        String?
  creadaEn  DateTime @default(now())
  negocio   Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([negocioId, creadaEn])
  @@index([usuarioId, creadaEn])
}
